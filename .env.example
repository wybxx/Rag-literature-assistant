# LLM API 配置（复制本文件为 .env 并填入你自己的 key）
# 对话模型 DeepSeek 申请: https://platform.deepseek.com
LLM_API_KEY=sk-在这里填你的DeepSeek密钥
LLM_BASE_URL=https://api.deepseek.com
LLM_CHAT_MODEL=deepseek-chat

# Embedding 向量模型走硅基流动（DeepSeek 不提供向量化接口）
# 硅基流动申请（注册送额度）: https://cloud.siliconflow.cn → API 密钥
EMBEDDING_API_KEY=sk-在这里填你的硅基流动密钥
EMBEDDING_BASE_URL=https://api.siliconflow.cn/v1
EMBEDDING_MODEL=BAAI/bge-m3
